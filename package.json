{
	"name": "clonelane",
	"version": "0.1.0",
	"description": "Keep your Git workspaces in the same lane.",
	"type": "module",
	"license": "MIT",
	"author": "Dohyun Lee",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/korbethebest/clonelane.git"
	},
	"homepage": "https://github.com/korbethebest/clonelane#readme",
	"bugs": {
		"url": "https://github.com/korbethebest/clonelane/issues"
	},
	"keywords": [
		"git",
		"worktree",
		"clone",
		"sync",
		"fast-forward",
		"rebase",
		"dotenv",
		"cli",
		"electron"
	],
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@10.32.1",
	"bin": {
		"clonelane": "dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"SECURITY.md",
		"LICENSE"
	],
	"scripts": {
		"dev": "node src/cli.ts",
		"app": "pnpm build && install-electron && electron app/main.js",
		"build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"test": "node --test tests/*.spec.ts",
		"lint": "biome check .",
		"format": "biome format --write .",
		"prepack": "pnpm typecheck && pnpm test && pnpm build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/node": "26.6.4",
		"electron": "45.3.3",
		"typescript": "~7.0.2"
	}
}
